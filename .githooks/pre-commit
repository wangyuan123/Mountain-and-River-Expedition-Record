#!/usr/bin/env bash
# Git pre-commit hook: 提交前校验代码编译与测试

set -Eeuo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# 终端颜色支持
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

echo -e "${BLUE}${BOLD}==> [Git Hook: pre-commit] 开始执行提交前代码校验...${NC}"

# 获取本次暂存的文件列表
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM || true)"

if [[ -z "$STAGED_FILES" ]]; then
  echo -e "${GREEN}[Pre-Commit] 未检测到暂存文件，跳过校验。${NC}"
  exit 0
fi

# 判断受影响的模块
HAS_BACKEND_CHANGES=false
HAS_FRONTEND_CHANGES=false

while IFS= read -r file; do
  if [[ "$file" =~ ^backend/ ]]; then
    HAS_BACKEND_CHANGES=true
  elif [[ "$file" =~ ^frontend/ ]]; then
    HAS_FRONTEND_CHANGES=true
  fi
done <<< "$STAGED_FILES"

if ! $HAS_BACKEND_CHANGES && ! $HAS_FRONTEND_CHANGES; then
  echo -e "${GREEN}[Pre-Commit] 变更未涉及后端或前端代码，跳过校验。${NC}"
  exit 0
fi

# ==============================================================================
# 1. 后端校验
# ==============================================================================
if $HAS_BACKEND_CHANGES; then
  echo -e "${YELLOW}--> [Pre-Commit] 检测到后端代码变更，正在初始化 Java & Maven 环境...${NC}"
  
  # 载入环境检测脚本
  if [[ -f "$ROOT_DIR/scripts/env-check.sh" ]]; then
    source "$ROOT_DIR/scripts/env-check.sh"
  else
    echo -e "${RED}[Pre-Commit] 未找到 scripts/env-check.sh！${NC}" >&2
    exit 1
  fi

  echo -e "${YELLOW}--> [Pre-Commit] 正在执行后端编译检查 (test-compile)...${NC}"
  if ! "$MVN_CMD" -f "$ROOT_DIR/backend/pom.xml" -B test-compile -DskipTests; then
    echo -e "${RED}${BOLD}===================================================================${NC}"
    echo -e "${RED}${BOLD}[Pre-Commit 拦截] 后端代码编译失败！${NC}"
    echo -e "${RED}请检查上方 javac / Lombok 报错信息，修复后再执行 git commit。${NC}"
    echo -e "${RED}${BOLD}===================================================================${NC}"
    exit 1
  fi
  echo -e "${GREEN}[Pre-Commit] 后端代码编译通过 ✓${NC}"

  # 单元测试检查
  if [[ "${FAST_COMMIT:-0}" == "1" || "${SKIP_BACKEND_TESTS:-0}" == "1" ]]; then
    echo -e "${YELLOW}[Pre-Commit] FAST_COMMIT=1 已启用，跳过后端单元测试。${NC}"
  else
    echo -e "${YELLOW}--> [Pre-Commit] 正在运行后端单元测试 (如需跳过测试可使用 FAST_COMMIT=1 git commit)...${NC}"
    if ! "$MVN_CMD" -f "$ROOT_DIR/backend/pom.xml" -B test; then
      echo -e "${RED}${BOLD}===================================================================${NC}"
      echo -e "${RED}${BOLD}[Pre-Commit 拦截] 后端单元测试未通过！${NC}"
      echo -e "${RED}请修复上述失败测试用例，或使用 FAST_COMMIT=1 git commit 仅进行编译校验。${NC}"
      echo -e "${RED}${BOLD}===================================================================${NC}"
      exit 1
    fi
    echo -e "${GREEN}[Pre-Commit] 后端单元测试通过 ✓${NC}"
  fi
fi

# ==============================================================================
# 2. 前端校验
# ==============================================================================
if $HAS_FRONTEND_CHANGES; then
  echo -e "${YELLOW}--> [Pre-Commit] 检测到前端代码变更，正在运行前端测试...${NC}"
  if command -v node >/dev/null 2>&1; then
    if ! node --test "$ROOT_DIR"/frontend/tests/*.test.cjs; then
      echo -e "${RED}${BOLD}===================================================================${NC}"
      echo -e "${RED}${BOLD}[Pre-Commit 拦截] 前端回归测试未通过！${NC}"
      echo -e "${RED}请检查 frontend/tests 中的失败项后再提交。${NC}"
      echo -e "${RED}${BOLD}===================================================================${NC}"
      exit 1
    fi
    echo -e "${GREEN}[Pre-Commit] 前端测试通过 ✓${NC}"
  else
    echo -e "${YELLOW}[Pre-Commit] 警告：未检测到 node 环境，跳过前端测试。${NC}"
  fi
fi

echo -e "${GREEN}${BOLD}==> [Git Hook: pre-commit] 所有校验均已通过，允许提交！✓${NC}"
exit 0
