#!/usr/bin/env bash
# Git pre-push hook: 推送前完整验证测试

set -Eeuo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# 终端颜色
GREEN='\033[0;32m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

if ! git lfs version >/dev/null 2>&1; then
  echo "[错误] 推送归档源码包需要 Git LFS，请先安装 git-lfs。" >&2
  exit 1
fi

echo -e "${BLUE}${BOLD}==> [Git Hook: pre-push] 正在执行全量回归验证...${NC}"

if [[ -f "$ROOT_DIR/scripts/verify.sh" ]]; then
  bash "$ROOT_DIR/scripts/verify.sh"
fi

# 测试通过后上传源码归档对象，确保远程提交中的 LFS 指针有对应文件。
git lfs pre-push "$@"

echo -e "${GREEN}${BOLD}==> [Git Hook: pre-push] 全量测试验证通过，允许推送！✓${NC}"
exit 0
