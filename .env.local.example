# 复制为 .env.local，仅由本地启动脚本读取；上线部署使用独立的 .env。
# 该文件会作为 Shell 配置加载，含 & 或空格的值应加引号。
SPRING_PROFILES_ACTIVE=local
WARGAME_DB_URL='jdbc:mysql://localhost:3306/wargame?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true'
WARGAME_DB_USER=root
WARGAME_DB_PASSWORD=

# 未配置本机 SMTP 与邮箱密钥时，已有账号可登录，邮件注册和找回不可用。
# 如需本机邮件验收，请在 .env.local 单独配置 WARGAME_MAIL_* 和邮箱密钥。
WARGAME_EMAIL_ENABLED=false
