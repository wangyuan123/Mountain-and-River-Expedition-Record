# ============================================================================
# .env.example — copy to .env and fill in real values.
# Spring Boot's @Value("${WARGAME_*}") will read from environment variables,
# OR via spring-dotenv if you add the dotenv-maven plugin.
# ============================================================================

# MySQL connection
WARGAME_DB_URL=jdbc:mysql://localhost:3306/wargame?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
WARGAME_DB_USER=wargame
WARGAME_DB_PASSWORD=please-change-me

# JWT signing key. MUST be at least 32 random bytes. Generate with:
#   openssl rand -base64 48
#   or  head -c 48 /dev/urandom | base64
WARGAME_JWT_SECRET=replace-me-with-a-48-byte-random-string-please
WARGAME_JWT_EXPIRATION=86400000

# 后台会话默认 2 小时，允许 300000—28800000 毫秒。
WARGAME_ADMIN_JWT_EXPIRATION=7200000
# 显式初始化管理员：12—64 字符、至多 72 个 UTF-8 字节；留空不创建可用默认口令。
# 仅创建新账号或替换旧迁移的固定口令，绝不重置已配置的管理员。初始化后删除此密码配置。
WARGAME_ADMIN_BOOTSTRAP_USERNAME=admin
WARGAME_ADMIN_BOOTSTRAP_PASSWORD=

# 限流、注册登录、邮箱、审计统一使用；仅受控代理 IP/CIDR，默认不信任转发头。
# 代理必须覆盖来源头；不要填 /0 或包含公网客户端的网段。容器地址变化时须同步更新。
WARGAME_TRUSTED_PROXIES=
WARGAME_RATE_IP_PER_MINUTE=1200
WARGAME_RATE_IP_WRITES_PER_MINUTE=300
WARGAME_RATE_ACCOUNT_PER_MINUTE=600
WARGAME_RATE_ACCOUNT_WRITES_PER_MINUTE=120
WARGAME_RATE_WS_PER_IP_PER_MINUTE=60
WARGAME_RATE_ADMIN_LOGIN_PER_IP_PER_MINUTE=20
WARGAME_RATE_ADMIN_LOGIN_PER_ACCOUNT_PER_QUARTER_HOUR=10

# 每个部署实例绑定一个大区；现有数据库归属江苏一区。
WARGAME_SERVER_ID=jiangsu-1
WARGAME_SERVER_NAME=公测一区

# QQ 邮箱验证码：SMTP 使用授权码；缺少配置时暂停新注册/发码，原密码登录可用。
WARGAME_EMAIL_ENABLED=true
WARGAME_MAIL_HOST=smtp.qq.com
WARGAME_MAIL_PORT=465
WARGAME_MAIL_SSL=true
WARGAME_MAIL_USERNAME=
WARGAME_MAIL_PASSWORD=
WARGAME_MAIL_FROM=
# 两个独立密钥分别执行 openssl rand -base64 32 生成；备份并保留，不能直接更换已有数据的密钥。
WARGAME_EMAIL_DATA_KEY=
WARGAME_EMAIL_HMAC_KEY=
WARGAME_MAIL_HOURLY_LIMIT=200
WARGAME_MAIL_DAILY_LIMIT=1000
WARGAME_MAIL_QUEUE_LIMIT=1000
# 旧变量仅作兼容，迁移到 WARGAME_TRUSTED_PROXIES 后请清空。
WARGAME_MAIL_TRUSTED_PROXIES=

# 暂停防沉迷，产品完善后恢复为 true；恢复步骤见 docs/ANTI_ADDICTION_IMPLEMENTATION.md。
WARGAME_COMPLIANCE_ENABLED=false
# 实名主体加密/HMAC 密钥：openssl rand -base64 32。各实例一致，勿直接更换已有数据的密钥。
WARGAME_COMPLIANCE_DATA_KEY=
# 经运营审核的日期覆盖区间（YYYY-MM-DD）及审核来源；未配置时拒绝未成年人游戏。
WARGAME_PLAY_CALENDAR_FROM=
WARGAME_PLAY_CALENDAR_THROUGH=
WARGAME_PLAY_CALENDAR_SOURCE=
# 逗号分隔的额外开放日/关闭日。周五六日是基础规则，关闭日优先。
WARGAME_PLAY_EXTRA_OPEN_DATES=
WARGAME_PLAY_CLOSED_DATES=
WARGAME_SUPPORT_URL=

# 跨域客户端来源白名单（逗号分隔，包含协议和端口，不含路径）。生产留空仅允许同源。
# 独立论坛继续访问 API 时，将其现有来源也加入此列表。
WARGAME_ALLOWED_ORIGINS=
