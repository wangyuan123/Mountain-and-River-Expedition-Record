# ============================================================================
# .env.example — copy to .env and fill in real values.
# Spring Boot's @Value("${WARGAME_*}") will read from environment variables,
# OR via spring-dotenv if you add the dotenv-maven plugin.
# ============================================================================

# MySQL connection
WARGAME_DB_URL=jdbc:mysql://localhost:3306/wargame?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
WARGAME_DB_USER=wargame
WARGAME_DB_PASSWORD=please-change-me

# JWT signing key. MUST be at least 32 random bytes. Generate with:
#   openssl rand -base64 48
#   or  head -c 48 /dev/urandom | base64
WARGAME_JWT_SECRET=replace-me-with-a-48-byte-random-string-please
WARGAME_JWT_EXPIRATION=86400000

# 实名主体加密/HMAC 密钥：openssl rand -base64 32。各实例一致，勿直接更换已有数据的密钥。
WARGAME_COMPLIANCE_DATA_KEY=
# 经运营审核的日期覆盖区间（YYYY-MM-DD）及审核来源；未配置时拒绝未成年人游戏。
WARGAME_PLAY_CALENDAR_FROM=
WARGAME_PLAY_CALENDAR_THROUGH=
WARGAME_PLAY_CALENDAR_SOURCE=
# 逗号分隔的额外开放日/关闭日。周五六日是基础规则，关闭日优先。
WARGAME_PLAY_EXTRA_OPEN_DATES=
WARGAME_PLAY_CLOSED_DATES=
WARGAME_SUPPORT_URL=
