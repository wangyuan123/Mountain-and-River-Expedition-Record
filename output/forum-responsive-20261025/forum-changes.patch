--- forum/src/assets/styles/responsive.css
+++ forum/src/assets/styles/responsive.css
@@ -0,0 +1,127 @@
+/* 论坛容器按自身视口适配；iframe 的宽高由游戏聊天页负责。 */
+.wap-container {
+  width: 100%;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.wap-container .wap-main,
+.wap-container .wap-main > *,
+.wap-container .wap-user-status-strip > span {
+  min-width: 0;
+}
+
+.wap-container .banner-left-links,
+.wap-container .wap-sub-links-bar {
+  flex-wrap: wrap;
+  white-space: normal;
+}
+
+.wap-container .banner-link,
+.wap-container .wap-sub-links-bar > a {
+  white-space: nowrap;
+}
+
+.wap-container .topic-sub-meta,
+.wap-container .filter-chips,
+.wap-container .wap-pagination-bar,
+.wap-container .mod-links,
+.wap-container .reply-action-links,
+.wap-container .editor-title-row {
+  flex-wrap: wrap;
+}
+
+.wap-container .wap-inline-search {
+  min-width: 0;
+  max-width: 100%;
+}
+
+.wap-container .wap-search-input {
+  min-width: 0;
+}
+
+.wap-container .form-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+  min-width: 0;
+}
+
+.wap-container .form-label {
+  margin-right: 0;
+}
+
+.wap-container .wap-text-input,
+.wap-container .wap-select {
+  min-width: 0;
+  max-width: 100%;
+  flex: 1 1 160px;
+}
+
+.wap-container .wap-textarea,
+.wap-container .wap-reply-textarea {
+  min-width: 0;
+  max-width: 100%;
+}
+
+.wap-container .bounty-subrow > .text-muted,
+.wap-container .battle-subrow > .text-muted {
+  flex-basis: 100%;
+}
+
+/* 横屏展开600像素的旧容器；仅使用布局规则，不重设组件库主题。 */
+@media (orientation: landscape) {
+  .wap-container {
+    max-width: 1200px;
+  }
+
+  .wap-container .wap-announcements {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 4px 20px;
+  }
+}
+
+/* 嵌入游戏时占满内容区；导航在Vue中合并为一层，避免重复的游戏入口。 */
+.wap-container.is-embedded {
+  max-width: none;
+  min-height: 100vh;
+  min-height: 100dvh;
+}
+
+@media (orientation: landscape) and (min-width: 720px) {
+  .wap-container .wap-city-status,
+  .wap-container .wap-form-container {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 8px 16px;
+    align-items: start;
+  }
+
+  .wap-container .wap-form-container > .form-row {
+    margin-bottom: 0;
+  }
+
+  .wap-container .form-row-wide {
+    grid-column: 1 / -1;
+  }
+
+  .wap-container .wap-topic-line {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
+    gap: 4px 16px;
+    align-items: start;
+  }
+
+  .wap-container .topic-sub-meta {
+    max-width: 320px;
+  }
+}
+
+/* 矮横屏缩短编辑框的初始高度；正文仍可滚动、手动拉伸，提交按钮可随页面滚动到达。 */
+@media (orientation: landscape) and (max-height: 600px) {
+  .wap-container .wap-textarea {
+    height: clamp(96px, 30vh, 160px);
+  }
+}
